local function GetTargetScale()
	local viewport = camera and camera.ViewportSize or Vector2.new(854, 480)
	local minDim = math.min(viewport.X, viewport.Y)
	return math.clamp(minDim / 520, 0.78, 1.0)
end

local function UpdateResponsiveScale()
	GuiScale.Scale = GetTargetScale()
end

