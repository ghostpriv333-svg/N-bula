local function ClearFolder(folder)
	for _, child in ipairs(folder:GetChildren()) do
		pcall(function()
			child:Destroy()
		end)
	end
end

local function IsPrefab(obj)
	local cur = obj
	while cur and cur ~= Workspace do
		if string.find(string.lower(cur.Name), "prefab") then
			return true
		end
		cur = cur.Parent
	end
	return false
end

local function HasAnyBasePart(model)
	if not model or not model:IsA("Model") then
		return false
	end
	return model:FindFirstChildWhichIsA("BasePart", true) ~= nil
end

local function CreateSoftHighlight(adornee, fillColor, outlineColor, parent)
	if not adornee then
		return
	end
	local hl = Instance.new("Highlight")
	hl.Adornee = adornee
	hl.FillColor = fillColor
	hl.OutlineColor = outlineColor
	hl.FillTransparency = 0.72
	hl.OutlineTransparency = 0.15
	hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	hl.Parent = parent
end

local function IsComputerCompleted(pcModel)
	local screen = pcModel:FindFirstChild("Screen", true)
	if screen and screen:IsA("BasePart") then
		return screen.Color.G > 0.55 and screen.Color.R < 0.35
	end
	return false
end

local function IsComputerBeingHacked(pcModel)
	return pcModel:FindFirstChild("HackComputerScript", true) ~= nil
end

-- ==========================================
-- FUNÇÕES DE ESP
-- ==========================================
local function RefreshPCESP()
	ClearFolder(EspFolders.PC)
	if not States.PCESP then
		return
	end

	for _, obj in ipairs(Workspace:GetDescendants()) do
		if obj:IsA("Model") and obj.Name == "ComputerTable" and not IsPrefab(obj) and HasAnyBasePart(obj) then
			local done = IsComputerCompleted(obj)
			local hacking = IsComputerBeingHacked(obj)

			local fill = done and Color3.fromRGB(55, 200, 110)
				or (hacking and Color3.fromRGB(90, 185, 255) or Color3.fromRGB(245, 185, 55))
			local outline = done and Color3.fromRGB(120, 255, 165)
				or (hacking and Color3.fromRGB(165, 225, 255) or Color3.fromRGB(255, 125, 35))

			CreateSoftHighlight(obj, fill, outline, EspFolders.PC)
		end
	end
end

local function RefreshExitDoorESP()
	ClearFolder(EspFolders.ExitDoor)
	if not States.ExitDoorESP then
		return
	end

	for _, obj in ipairs(Workspace:GetDescendants()) do
		if obj:IsA("Model") and obj.Name == "ExitDoor" and not IsPrefab(obj) and HasAnyBasePart(obj) then
			local parentModel = obj.Parent
			local nested = false
			while parentModel and parentModel ~= Workspace do
				if parentModel:IsA("Model") and parentModel.Name == "ExitDoor" then
					nested = true
					break
				end
				parentModel = parentModel.Parent
			end

			if not nested then
				CreateSoftHighlight(
					obj,
					Color3.fromRGB(70, 215, 195),
					Color3.fromRGB(130, 255, 235),
					EspFolders.ExitDoor
				)
			end
		end
	end
end

local function RefreshPlayerESP()
	ClearFolder(EspFolders.Player)
	if not States.PlayerESP then
		return
	end

	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= player and plr.Character then
			local char = plr.Character
			local isBeast = false
			if char:FindFirstChild("BeastPowers") or char:FindFirstChild("Hammer") then
				isBeast = true
			end

			local fill = isBeast and Color3.fromRGB(220, 45, 45) or Color3.fromRGB(75, 175, 255)
			local outline = isBeast and Color3.fromRGB(255, 100, 100) or Color3.fromRGB(155, 215, 255)
			CreateSoftHighlight(char, fill, outline, EspFolders.Player)
		end
	end
end

-- ==========================================
-- AUTOPC (FOCO APENAS NO ACERTO DO MINIGAME)
-- ==========================================
local lastActionClock = 0

local function FindActiveTimingCircle()
	for _, desc in ipairs(playerGui:GetDescendants()) do
		if desc:IsA("GuiObject") and desc.Visible then
			local lowerName = string.lower(desc.Name)
			if desc.Name == "TimingCircle" or string.find(lowerName, "timingcircle", 1, true) then
				return desc
			end
		end
	end
	return nil
end

local function TryRemoteMinigameResult()
	pcall(function()
		local remote = ReplicatedStorage:FindFirstChild("RemoteEvent", true)
		if remote and remote:IsA("RemoteEvent") then
			remote:FireServer("SetPlayerMinigameResult", true)
		end
	end)
end

local function TryHitTimingCircle(circle)
	if not circle then
		return
	end
	if os.clock() - lastActionClock < 0.30 then
		return
	end
	lastActionClock = os.clock()

	TryRemoteMinigameResult()

	pcall(function()
		if VirtualInputManager then
			VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Space, false, game)
			task.wait(0.03)
			VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Space, false, game)
		end
	end)
end

local function StepAutoPC()
	if not States.AutoPC then
		return
	end

	local circle = FindActiveTimingCircle()
	if circle then
		TryHitTimingCircle(circle)
	end
end

task.spawn(function()
	while playerGui and playerGui.Parent do
		if States.PCESP then
			pcall(RefreshPCESP)
		end
		if States.ExitDoorESP then
			pcall(RefreshExitDoorESP)
		end
		if States.PlayerESP then
			pcall(RefreshPlayerESP)
		end
		task.wait(1.25)
	end
end)

task.spawn(function()
	while playerGui and playerGui.Parent do
		if States.AutoPC then
			pcall(StepAutoPC)
			task.wait(0.08)
		else
			task.wait(0.25)
		end
	end
end)

local function OnToggleAutoPC(enabled: boolean)
	print("[AutoPC]:", enabled and "ATIVADO (foco no minigame)" or "DESATIVADO")
	if enabled then
		pcall(StepAutoPC)
	end
end

local function OnTogglePlayerESP(enabled: boolean)
	print("[Player ESP]:", enabled and "ATIVADO" or "DESATIVADO")
	RefreshPlayerESP()
end

local function OnTogglePCESP(enabled: boolean)
	print("[PC ESP]:", enabled and "ATIVADO" or "DESATIVADO")
	RefreshPCESP()
end

local function OnToggleExitDoorESP(enabled: boolean)
	print("[Exit Door ESP]:", enabled and "ATIVADO" or "DESATIVADO")
	RefreshExitDoorESP()
end

