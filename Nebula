local progressoAtual = 0

local function setProgresso(pctAlvo, texto)
	if texto and LSub and LSub.Parent then
		LSub.Text = texto
	end

	pctAlvo = math.clamp(pctAlvo, progressoAtual, 100)
	local passos = math.max(1, pctAlvo - progressoAtual)

	for i = 1, passos do
		progressoAtual += 1
		if LBarFill and LBarFill.Parent then
			LBarFill.Size = UDim2.new(progressoAtual / 100, 0, 1, 0)
		end
		if LPct and LPct.Parent then
			LPct.Text = tostring(progressoAtual) .. "%"
		end
		if passos > 10 then
			if i % 3 == 0 then
				task.wait(0.01)
			end
		else
			task.wait(0.012)
		end
	end
end
