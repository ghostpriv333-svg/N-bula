local function obterViewport()
	local cam = workspace.CurrentCamera
	if cam and cam.ViewportSize.X > 0 and cam.ViewportSize.Y > 0 then
		return cam.ViewportSize
	end
	return Vector2.new(854, 480)
end

local function calcularLoaderSize(vp)
	local w = math.clamp(math.floor(vp.X * 0.56), 270, 410)
	local h = math.clamp(math.floor(vp.Y * 0.48), 155, 200)
	return w, h
end

local function calcularHubSize(vp)
	local isMobileSmall = (vp.X <= 820) or (vp.Y <= 450)
	local wRatio = isMobileSmall and 0.78 or 0.68
	local hRatio = isMobileSmall and 0.78 or 0.72
	local w = math.clamp(math.floor(vp.X * wRatio), 310, 680)
	local h = math.clamp(math.floor(vp.Y * hRatio), 215, 380)
	return w, h
end

local function animar(instancia, duracao, estilo, direcao, propriedades)
	if not instancia or not instancia.Parent then
		return
	end
	pcall(function()
		local info = TweenInfo.new(
			duracao,
			estilo or Enum.EasingStyle.Quart,
			direcao or Enum.EasingDirection.Out
		)
		local tween = TweenService:Create(instancia, info, propriedades)
		tween:Play()
	end)
end

local function executarScriptRemoto(urlBase, nomeModulo)
	local ok, err = pcall(function()
		local url = urlBase .. "?v=" .. tostring(os.clock())
		local codigo = game:HttpGet(url, true)
		local fn = loadstring(codigo)
		if fn then
			fn()
		else
			error("Erro de compilacao no modulo " .. tostring(nomeModulo))
		end
	end)

	if not ok then
		warn("[Nebula Hub] Falha ao carregar " .. tostring(nomeModulo) .. ": " .. tostring(err))
	end
end

local function obterImagemJogo(universeId, placeId)
	local candidatos = {}

	local targetUniverse = (universeId and universeId > 0) and universeId or game.GameId
	local targetPlace = (placeId and placeId > 0) and placeId or game.PlaceId

	if targetUniverse and targetUniverse > 0 then
		table.insert(candidatos, "rbxthumb://type=GameIcon&id=" .. tostring(targetUniverse) .. "&w=256&h=256")
		table.insert(candidatos, "rbxthumb://type=GameThumbnail&id=" .. tostring(targetUniverse) .. "&w=420&h=236")
	end

	if targetPlace and targetPlace > 0 then
		table.insert(candidatos, "rbxthumb://type=GameIcon&id=" .. tostring(targetPlace) .. "&w=256&h=256")
		table.insert(candidatos, "rbxthumb://type=GameThumbnail&id=" .. tostring(targetPlace) .. "&w=420&h=236")
	end

	if targetPlace ~= FTF_PLACE_ID then
		table.insert(candidatos, "rbxthumb://type=GameIcon&id=" .. tostring(FTF_PLACE_ID) .. "&w=256&h=256")
		table.insert(candidatos, "rbxthumb://type=GameThumbnail&id=" .. tostring(FTF_PLACE_ID) .. "&w=420&h=236")
	end

	if targetUniverse and targetUniverse > 0 then
		pcall(function()
			local url = "https://thumbnails.roblox.com/v1/games/icons?universeIds="
				.. tostring(targetUniverse)
				.. "&returnPolicy=PlaceHolder&size=256x256&format=Png&isCircular=false"
			local raw = game:HttpGet(url)
			local data = HttpService:JSONDecode(raw)
			if data and data.data and data.data[1] and data.data[1].imageUrl and data.data[1].imageUrl ~= "" then
				table.insert(candidatos, 1, data.data[1].imageUrl)
			end
		end)
	end

	for _, asset in ipairs(candidatos) do
		local ok = pcall(function()
			local tempImg = Instance.new("ImageLabel")
			tempImg.Image = asset
			ContentProvider:PreloadAsync({tempImg})
			tempImg:Destroy()
		end)
		if ok and asset ~= "" then
			return asset
		end
	end

	return candidatos[1] or ""
end

