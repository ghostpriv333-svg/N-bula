local function animar(instancia, duracao, estilo, direcao, propriedades)
	if not instancia or not instancia.Parent then
		return
	end
	pcall(function()
		local info = TweenInfo.new(
			duracao,
			estilo or Enum.EasingStyle.Quart,
			direcao or Enum.EasingDirection.Out
		)
		local tween = TweenService:Create(instancia, info, propriedades)
		tween:Play()
	end)
end

